---
import Layout from '../layouts/Layout.astro';

const phone = "410-000-0000";
const city = "Phoenix";
const niche = "Septic Pumping";
---

<Layout 
	title={`About Us | Locally Owned ${city} ${niche} Service`}
	phone={phone}
	city={city}
	niche={niche}
>
	<main class="max-w-4xl mx-auto px-6 py-20">
		<h1 class="text-4xl font-black mb-8 border-b-4 border-red-600 inline-block">About Us</h1>
		
		<div class="prose prose-slate lg:prose-xl">
			<p class="text-xl leading-relaxed mb-6">
				Unlike the big national franchises, we are your neighbors. We live in Maryland, work in Maryland, and understand the unique environmental needs of our local community.
			</p>
			
			<h2 class="text-2xl font-bold mt-12 mb-4">Dedicated to {city} Neighbors</h2>
			<p class="mb-6">
				Our mission is simple: to provide the highest quality {niche} services in {city} at a fair, local price. We’ve built our reputation on fast response times, professional expertise, and a 100% satisfaction guarantee.
			</p>

			<div class="bg-slate-100 p-8 rounded-lg border-l-8 border-blue-600 mt-12">
				<h3 class="text-xl font-bold mb-2">Why Trust Us?</h3>
				<ul class="space-y-4">
					<li>✅ **Local Expertise:** We know the soil and terrain of Maryland.</li>
					<li>✅ **Fast Response:** Based right here in {city}.</li>
					<li>✅ **No Games:** Transparent pricing and honest assessments.</li>
				</ul>
			</div>
		</div>
	</main>
</Layout>
