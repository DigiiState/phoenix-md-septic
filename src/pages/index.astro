---
import Layout from '../layouts/Layout.astro';

const phone = "410-000-0000";
const city = "Phoenix";
const niche = "Septic Pumping";
---

<Layout 
	title={`${city} MD ${niche} & Emergency Service | Locally Owned`}
	phone={phone}
	city={city}
	niche={niche}
>
	<!-- NOLA-Style Hero with Integrated Form -->
	<section class="relative bg-slate-900 text-white overflow-hidden">
		<div class="absolute inset-0 opacity-20 bg-[url('https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=1200&q=80')] bg-cover bg-center"></div>
		<div class="relative max-w-5xl mx-auto px-6 py-16 md:py-24 flex flex-col md:flex-row gap-12 items-center">
			<div class="flex-1 text-center md:text-left">
				<h1 class="text-4xl md:text-5xl font-black leading-none mb-6">
					{city} MD {niche} & <span class="text-red-500 underline">EMERGENCY</span> Service
				</h1>
				<p class="text-lg text-slate-300 mb-8 max-w-xl">
					Locally Owned and Operated in Maryland. 100% Satisfaction Guaranteed for Howard & Baltimore County Neighbors.
				</p>
				<div class="inline-grid grid-cols-1 gap-3 text-sm font-bold bg-white/10 p-4 rounded-lg backdrop-blur-sm">
					<div class="flex items-center gap-2">✅ Same Day Dispatch</div>
					<div class="flex items-center gap-2">✅ Licensed MD Technicians</div>
					<div class="flex items-center gap-2">✅ Emergency Response</div>
				</div>
			</div>

			<!-- NOLA Hero Form -->
			<div class="w-full md:w-80 bg-white p-6 rounded shadow-2xl text-slate-900">
				<div class="bg-red-600 text-white -mx-6 -mt-6 p-3 text-center font-black text-sm uppercase tracking-tighter mb-6 rounded-t">
					Free Instant Quote
				</div>
				<form class="space-y-4">
					<input type="text" placeholder="Your Name" class="w-full border border-slate-300 p-2 rounded focus:border-blue-600 outline-none" />
					<input type="tel" placeholder="Phone Number" class="w-full border border-slate-300 p-2 rounded focus:border-blue-600 outline-none" />
					<input type="text" placeholder="Service Needed" class="w-full border border-slate-300 p-2 rounded focus:border-blue-600 outline-none" />
					<button type="submit" class="w-full bg-blue-600 text-white py-3 font-black uppercase tracking-widest hover:bg-blue-700 transition-colors">
						Get My Quote Now
					</button>
				</form>
			</div>
		</div>
	</section>

	<!-- Irving Value Stack -->
	<section class="bg-slate-100 py-10 border-b border-slate-200">
		<div class="max-w-4xl mx-auto grid grid-cols-3 gap-4 text-center">
			<div class="space-y-1">
				<div class="text-2xl">🛡️</div>
				<div class="text-[10px] md:text-xs font-black uppercase text-slate-500">100% Guaranteed</div>
			</div>
			<div class="space-y-1">
				<div class="text-2xl">🏡</div>
				<div class="text-[10px] md:text-xs font-black uppercase text-slate-500">Locally Owned</div>
			</div>
			<div class="space-y-1">
				<div class="text-2xl">⚡</div>
				<div class="text-[10px] md:text-xs font-black uppercase text-slate-500">Emergency Service</div>
			</div>
		</div>
	</section>

	<!-- Abundant Clarity Content Silos -->
	<section class="max-w-4xl mx-auto px-6 py-20">
		<h2 class="text-3xl font-black mb-12 border-b-4 border-blue-600 inline-block">Maryland Septic Solutions</h2>
		
		<div class="space-y-12">
			<div class="border-l-4 border-blue-600 pl-6">
				<h3 class="text-xl font-bold mb-2">{city} MD {niche}</h3>
				<p class="text-slate-600 leading-relaxed">
					Routine pumping and cleaning to maintain system health in the {city} area. Our local team uses Maryland-approved methods to ensure your system operates at peak efficiency.
				</p>
			</div>
			
			<div class="border-l-4 border-blue-600 pl-6">
				<h3 class="text-xl font-bold mb-2">Western Howard County Drain Field Repair</h3>
				<p class="text-slate-600 leading-relaxed">
					Save thousands with our Maryland-approved restoration methods. We fix soggy yards and slow drains in Clarksville, Dayton, and surrounding communities.
				</p>
			</div>
		</div>
	</section>
</Layout>
